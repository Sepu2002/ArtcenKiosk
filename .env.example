# Copy this file to .env and adjust for this site. .env is gitignored.

# Number of locker doors on the board
NUM_LOCKERS=8

# IDs of physically-existing lockers that are out of service (e.g. a damaged
# port on the board that hasn't been rewired around) — comma-separated,
# e.g. "1" or "1,4". Left out of every deposit/open flow and shown as
# "out of service" instead of polled.
DISABLED_LOCKERS=

# Maps each locker (1..NUM_LOCKERS, in order) to the actual board channel it's
# wired to. Leave blank for the default 1:1 mapping. Use this when a board
# port is damaged and the doors get rewired to different channels instead of
# just losing a door — e.g. if board port 1 is dead and everything got
# rewired one channel over, LOCKER_CHANNELS=2,3,4,5 makes locker 1 talk to
# channel 2, locker 2 to channel 3, and so on.
LOCKER_CHANNELS=

# Serial connection to the Chinese locker control board
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=9600

# Length (hex chars) of generated pickup codes
PICKUP_CODE_LENGTH=8

# Flask session secret. Generate a real random value for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin password hash. Generate with:
#   python set_admin_password.py
ADMIN_PASSWORD_HASH=

# How long an admin stays logged in, in minutes
SESSION_LIFETIME_MINUTES=30

# Pickup code attempts allowed per IP before a temporary cooldown
PICKUP_RATE_LIMIT_ATTEMPTS=5
PICKUP_RATE_LIMIT_WINDOW_SECONDS=60
